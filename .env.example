# ===== ENVIRONMENT =====

# ===== Application =====
APP_NAME=Frigate SaaS Platform
APP_ENV=development  # development | staging | production
DEBUG=True
SECRET_KEY=change-me-to-random-32-byte-hex-key  # openssl rand -hex 32
JWT_SECRET=change-me-to-random-32-byte-hex-key   # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=frigate_saas
POSTGRES_USER=frigate
POSTGRES_PASSWORD=change-me-strong-password

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password
REDIS_DB=0

# ===== MinIO (S3-compatible) =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-secret-key
MINIO_BUCKET=tenants
MINIO_SECURE=False

# ===== MQTT (Mosquitto) =====
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=frigate
MQTT_PASSWORD=change-me-strong-password
MQTT_CLIENT_ID=portal-backend

# ===== Frigate Connection =====
FRIGATE_MQTT_TOPIC=frigate/events
FRIGATE_DEFAULT_URL=http://frigate:5000  # internal Docker network
FRIGATE_API_TIMEOUT_SEC=30

# ===== Edge Agent =====
EDGE_AGENT_HEARTBEAT_INTERVAL_SEC=30
EDGE_AGENT_CONFIG_PULL_INTERVAL_SEC=60
EDGE_AGENT_VERSION=1.0.0

# ===== Notification (n8n) =====
N8N_WEBHOOK_URL=http://n8n:5678/webhook/cctv-alert
N8N_API_KEY=change-me-if-needed

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@yourplatform.com

# ===== Tailscale =====
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxx  # from https://login.tailscale.com/admin/settings/keys

# ===== Logging =====
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# ===== Monitoring =====
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
ENABLE_METRICS=True

# ===== Multi-Tenant Defaults =====
DEFAULT_TENANT_CAMERA_LIMIT=100
DEFAULT_CAMERA_RETENTION_DAYS=7
DEFAULT_ALERT_COOLDOWN_SEC=300

# ===== Development Overrides =====
DATABASE_ECHO=False  # Set True to see SQL queries
RELOAD_ON_CHANGE=True  # Auto-reload FastAPI on code change