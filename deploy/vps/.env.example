# SPDX-License-Identifier: Apache-2.0
# Virex control-plane example env on the Hetzner VPS.
# Copy to .env and fill values. .env is gitignored.

# ---------------- Postgres ----------------
POSTGRES_DB=virex
POSTGRES_USER=virex
POSTGRES_PASSWORD=change-me

# ---------------- Portal secrets ----------------
# JWT signing secret (HS256). Used to sign both edge bearer tokens AND
# UI session cookies. Rotate via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and update both portal + edge agent after rotation (edge agents
# will need to re-register).
JWT_SECRET=change-me-to-48-bytes-of-random-data-XXXXXX

# Session cookie signing secret. Independent from JWT_SECRET so a
# session-token leak doesn't compromise edge JWTs.
SESSION_SECRET=change-me-too-also-random-XXXX

# Shared bootstrap secret for first-time edge-agent registration.
# Must match `VIREX_EDGE_BOOTSTRAP_SECRET` in deploy/edge/.env on each
# edge node. Used once per node — subsequent calls use the JWT.
VIREX_EDGE_BOOTSTRAP_SECRET=change-me-bootstrap-secret

# Set to true in production (HTTPS via Cloudflare Tunnel).
# Local dev: false (HTTP on 127.0.0.1).
COOKIE_SECURE=false

# Default tenant slug for subdomain routing + local-dev fallback.
DEFAULT_TENANT_SLUG=acme

# ---------------- Bootstrap admin (created by portal/seed.py) ----------------
# Email and password for the first admin user of the default tenant.
# CHANGE THESE before going to production.
BOOTSTRAP_ADMIN_EMAIL=admin@acme.example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# ---------------- Storage (MinIO inside this compose) ----------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# ---------------- Notification webhook (optional) ----------------
# n8n webhook — leave blank to skip notifications during pilot dev.
N8N_WEBHOOK_URL=

# ---------------- Edge node bootstrap ----------------
# Hostname + tailscale IP for the local edge-node record. The seed
# script reads these when creating the initial Node row.
VIREX_BOOTSTRAP_NODE_HOSTNAME=edge-rtx4070-1
VIREX_BOOTSTRAP_NODE_TS_IP=127.0.0.1
VIREX_BOOTSTRAP_NODE_MAX_CAMERAS=8