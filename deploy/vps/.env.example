# Virex control-plane example env on the Hetzner VPS.
# Copy to .env and fill values. .env is gitignored.

POSTGRES_DB=virex
POSTGRES_USER=virex
POSTGRES_PASSWORD=change-me

VIREX_EDGE_BEARER=virex-edge-shared-secret   # MUST match edge node's PORTAL_BEARER

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# n8n webhook — leave blank to skip notifications during pilot dev.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/virex-alert