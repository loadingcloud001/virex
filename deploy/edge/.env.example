# SPDX-License-Identifier: Apache-2.0
# Virex edge node — example env.
# Copy to `.env` and fill in real values.
#
# Storage backends supported by the minio Python SDK (S3-compatible):
#   1. Self-hosted MinIO           — MINIO_ENDPOINT=host:port (no scheme)
#   2. Tencent Cloud COS (CN/SG)   — MINIO_ENDPOINT=https://cos.<region>.myqcloud.com
#   3. AWS S3                       — MINIO_ENDPOINT=https://s3.<region>.amazonaws.com
#   4. Cloudflare R2                — MINIO_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
#   5. Backblaze B2                 — MINIO_ENDPOINT=https://s3.<region>.backblazeb2.com
#   6. Aliyun OSS                    — MINIO_ENDPOINT=https://oss-<region>.aliyuncs.com

# ---------------- Camera RTSP credentials ----------------
RTSP_PASSWORD_1=WL91619124
RTSP_PASSWORD_2=WL91619124

# ---------------- Storage (Tencent COS — production default) ----------------
# 1) Create bucket in Tencent COS console:
#    https://console.cloud.tencent.com/cos/bucket
#    Region: ap-singapore (or nearest to your edge)
#    ACL: 私有读写
#    Versioning: 关闭 (Phase 1)
#    Server-side encryption: SSE-COS
# 2) Create a CAM API key (SecretId / SecretKey) for the bucket.
MINIO_ENDPOINT=https://cos.ap-singapore.myqcloud.com
MINIO_REGION=ap-singapore             # required: MINIO SDK tries GetBucketLocation otherwise
MINIO_ACCESS_KEY=<COS_SECRET_ID>
MINIO_SECRET_KEY=<COS_SECRET_KEY>
MINIO_BUCKET=<BUCKET-NAME>-<APPID>     # e.g. virex-snapshots-1308927282
MINIO_SECURE=true

# ---------------- Custom CDN domain (optional, Phase 2) ----------------
# If you've attached a custom domain to the COS bucket (e.g.
# `snapshots.loadingtechnology.app` via the COS console → 自定义源站域名),
# set this so the future portal pre-signed-URL generator emits URLs that
# point at the custom domain instead of the raw COS endpoint. Leave
# empty to use the raw COS endpoint (no DNS/CDN involvement).
#
# Note: when pre-signing, the SDK signs for the bucket endpoint, NOT
# the custom domain. Pre-signed URLs are valid against EITHER host if
# the COS bucket allows it (default). To enforce custom-domain-only
# access, also configure a `Referrer` / `Referer` whitelist in the
# COS console → 权限管理 → 防盗链.
# MINIO_PUBLIC_ENDPOINT=https://snapshots.loadingtechnology.app

# ---------------- MQTT broker ----------------
# Phase 1: run a local mosquitto alongside the edge stack.
#   docker run -d --name mosquitto -p 1883:1883 eclipse-mosquitto:2
MQTT_BROKER=127.0.0.1:1883

# ---------------- Portal ----------------
# Phase 1: portal runs on the edge host for local piloting.
# Phase 2: move to VPS over Tailscale (100.x.x.x:8000).
PORTAL_INTERNAL_URL=http://127.0.0.1:8000

# Shared bootstrap secret for first-time edge-agent registration. The
# portal validates this on POST /api/edge/nodes/register and returns
# a long-lived JWT (30-day TTL). The JWT is persisted to
# $VIREX_EDGE_STATE_DIR/edge.jwt and used for every subsequent call.
# MUST match `VIREX_EDGE_BOOTSTRAP_SECRET` in deploy/vps/.env.
VIREX_EDGE_BOOTSTRAP_SECRET=virex-edge-bootstrap-secret-change-me

# Human-readable hostname the portal uses to identify this node.
# The portal's Node table enforces uniqueness per tenant — changing
# this after first registration creates a new Node row.
VIREX_EDGE_NODE_HOSTNAME=edge-rtx4070-1

# ---------------- Edge node identity ----------------
VIREX_NODE_ID=1